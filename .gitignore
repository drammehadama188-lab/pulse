node_modules
dist
.DS_Store
*.log
.env
.env.*

# Runtime data store (JSON persistence) — never commit staff data
/data/*.json
/data/*.bak*
/data/uploads/

# Local backups (contain customer + staff PII) — never commit
/data.backup-*/
**/*.backup-*.js

# Dev-only auth-seed helper (may hold a session token) — never commit
/public/_seed.html

# Zoho secrets — never commit. The refresh token lives in .env (already
# ignored above); these patterns are belt-and-suspenders in case a config or
# token file is ever written to disk.
.zoho-config.json
.zoho-tokens.json
.zoho-*.json
